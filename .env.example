# TESTNET ONLY throwaway account. Never put a mainnet key here. Never commit .env.
# Prefer `pnpm account:new`, which writes .env and .secrets/ for you.

# Classical secp256k1 key (0x + 64 hex). Used by Hardhat and `pnpm window`.
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# PQC recovery code (QRC1-...). Required with PRIVATE_KEY.
# Create one with `pnpm window recovery-code` if you are not using account:new.
QORE_PQC_RECOVERY_CODE=

# Optional alternative: a 12/24-word mnemonic instead of the two secrets above.
# QORE_MNEMONIC=

# Must stay testnet for this project.
QORE_NETWORK=testnet

QORE_WINDOW_BLOCKS=600
QORE_WINDOW_TXS=5

# Set after `pnpm deploy:testnet` (0x address of StampRegistry).
# STAMP_REGISTRY=
